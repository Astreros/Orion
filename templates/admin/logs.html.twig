{% extends 'base.html.twig' %}

{% block title %}Administration{% endblock %}

{% block body %}
    <style>
        .example-wrapper { margin: 1em auto; max-width: 80%; width: 95%; font: 18px/1.5 sans-serif; }
        .example-wrapper code { background: #38D5BE; padding: 2px 6px; }
        .table td, .table th { padding: 8px 15px; }
    </style>

    <div class="example-wrapper">
        <h1>Administration</h1>

        {% if app.user %}
            <a href="{{ path('app_logout') }}">Déconnexion</a>
        {% endif %}

        <br>
        <br>

        <a href="{{ path('show.admin') }}">Retour Accueil Administration</a>

        <div class="container mt-4">
            <h1>Activités</h1>

            <br>
            <br>

            {% if logs|length > 0 %}
                <table class="table table-striped">
                    <thead>
                    <tr>
                        <th>Date/heure</th>
                        <th>Niveau alerte</th>
                        <th>Commentaire</th>
                        <th>Type d'identification</th>
                        <th>Localisation</th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for log in logs %}
                        <tr>
                            <td>{{ log.dateHeure|date('Y-m-d H:i:s')}}</td>
                            <td>{{ log.nivAlerte }}</td>
                            <td>{{ log.commentaire }}</td>
                            <td>{{ log.typeIdentification}}</td>
                            <td>{{ log.localisation }}</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            {% else %}
                <div class="alert alert-info">
                    Aucune activités trouvée.
                </div>
            {% endif %}
        </div>
    </div>
{% endblock %}