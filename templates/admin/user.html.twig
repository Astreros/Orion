{% extends 'base.html.twig' %}

{% block title %}Administration Utilisateurs{% endblock %}

{% block body %}
    <style>
        .example-wrapper { margin: 1em auto; max-width: 80%; width: 95%; font: 18px/1.5 sans-serif; }
        .example-wrapper code { background: #38D5BE; padding: 2px 6px; }
        .table td, .table th { padding: 8px 15px; }
    </style>

    <div class="example-wrapper">
        <h1>Administration des utilisateurs</h1>

        {% if app.user %}
            <a href="{{ path('app_logout') }}">Déconnexion</a>
        {% endif %}

        <br>
        <br>

        <a href="{{ path('show.admin') }}">Retour Accueil Administration</a>

        <h1>Liste des utilisateurs</h1>

        {% if users|length > 0 %}
            <table class="table table-striped">
                <thead>
                <tr>
                    <th>Nom</th>
                    <th>Prénom</th>
                    <th>E-mail</th>
                    <th>Statut</th>
                    <th>Rôles</th>
                    <th>Actions</th>
                </tr>
                </thead>
                <tbody>
                {% for user in users %}
                    <tr>
                        <td>{{ user.nom }}</td>
                        <td>{{ user.prenom }}</td>
                        <td>{{ user.email }}</td>
                        <td>
                            <span class="badge bg-{{ user.actif ? 'success' : 'danger' }}">
                                    {{ user.actif ? 'Actif' : 'Inactif' }}
                            </span>
                        </td>
                        <td>
                            {% for role in user.roles %}
                                <p>{{ role }}</p>
                            {% endfor %}
                        </td>
                        <td>
                            <div class="btn-group" role="group">
                                {% if user.actif %}
                                    <a href="{{ path('disable.user', {'id': user.id}) }}" class="btn btn-warning btn-sm">Désactiver</a>
                                {% else %}
                                    <a href="{{ path('enable.user', {'id': user.id}) }}" class="btn btn-success btn-sm">Activer</a>
                                {% endif %}
                                <a href="{{ path('delete.user', {'id': user.id}) }}" class="btn btn-danger btn-sm" onclick="return confirm('Êtes-vous sûr de vouloir cette utilisateur ?')">Supprimer</a>
                                <br>
                                <a href="{{ path('update.user', {'userId': user.id}) }}" class="btn btn-danger btn-sm">Modifier</a>
                            </div>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        {% else %}
            <div class="alert alert-info">
                Aucun utilisateur trouvé.
            </div>
        {% endif %}
    </div>
{% endblock %}